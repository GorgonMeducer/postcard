{
    "version": "1.0.0",
    "configurations": [
        {
            "name": "build and run on macos (lldb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/postcard",
            "args": [
                "-p", 
                "test/photo.bmp", 
                //"test/monika.png", 
                "-t", 
                "test/story.txt",
                "--no_bg_color",
                //"-ratio","0",
                "--dryrun",
                "--oneside",
                "--event",
                "Silverstone",
                "--logo",
                "test/EventLogoAstonMartinF1.png",
                "--hide_default_logo",
                //"--footnote_height","200",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Make"
        },
        {
            "name": "build and run x86(32)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/postcard.exe",
            "args": [
                "-p", 
                "test/photo.bmp",  
                "-t", 
                "test/story.txt",
                "--no_bg_color",
                "--dryrun",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable gdb pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set disassbly flavor as Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Make"
        },
        {
            "name": "build and run Linux",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/postcard",
            "args": [
                "-p", 
                "test/photo.bmp", 
                "-t", 
                "test/story.txt",
                "--no_bg_color",
                "--dryrun",
                "--event",
                "Silverstone",
                "--logo",
                "test/EventLogoAstonMartinF1.png",
                "--hide_default_logo",
                //"--footnote_height","200",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch",
            "preLaunchTask": "Make"
        }
    ]
}